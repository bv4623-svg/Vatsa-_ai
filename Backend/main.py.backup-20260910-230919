class SearchTool:
    def __init__(self):
        self.api_key = os.getenv("TAVILY_API_KEY")

    async def execute(self, query, **kwargs):
        if not self.api_key:
            return {"success": False, "error": "Search not configured"}
        try:
            async with aiohttp.ClientSession() as session:
                async with session.post(
                    "https://api.tavily.com/search",
                    json={"api_key": self.api_key, "query": query, "max_results": 3, "search_depth": "basic"},
                    timeout=20,
                ) as resp:
                    if resp.status != 200:
                        return {"success": False, "error": f"Search API {resp.status}"}
                    data = await resp.json()
                    results = data.get("results", [])
                    if not results:
                        return {"success": True, "result": "No results found."}
                    snippets = "\n".join(f"- {r.get('title','')}: {r.get('content','')[:250]}" for r in results[:3])
                    return {"success": True, "result": snippets}
        except Exception as e:
            return {"success": False, "error": str(e)}


class CalculatorTool:
    async def execute(self, expression, **kwargs):
        try:
            if not re.match(r'^[\d+\-*/()\s.]+$', expression):
                return {"success": False, "error": "Invalid characters"}
            return {"success": True, "result": str(eval(expression, {"__builtins__": {}}, {}))}
        except Exception as e:
            return {"success": False, "error": str(e)}


def get_tool(tool_name):
    if tool_name == "search":
        return SearchTool()
    elif tool_name == "calculator":
        return CalculatorTool()
    class DummyTool:
        async def execute(self, **kwargs):
            return {"success": False, "error": f"Tool '{tool_name}' not implemented"}
    return DummyTool()

