def _clean_prompt(query):
    """Aggressively clean typos and filler words."""
    q = query.strip()

    # Remove common command prefixes
    q = re.sub(
        r"^(please\s+)?(generate|create|make|draw|paint|render|produce|design|imagine|show)\s+",
        "", q, flags=re.I,
    )
    q = re.sub(r"^(me\s+)?(an?\s+)?", "", q, flags=re.I)
    q = re.sub(
        r"^(ultra\s*[\s-]?\s*realstic\s+|ultra\s*[\s-]?\s*realistic\s+|realstic\s+|realistic\s+|hyper\s*[\s-]?\s*realistic\s+|detailed\s+|hd\s+|high\s*[\s-]?\s*quality\s+|4k\s+|8k\s+)",
        "", q, flags=re.I,
    )
    q = re.sub(
        r"^(image|picture|photo|photograph|illustration|artwork|drawing|portrait|art|pic)\s+",
        "", q, flags=re.I,
    )
    q = re.sub(r"^(of\s+|showing\s+|with\s+)", "", q, flags=re.I)
    q = re.sub(r"^(a\s+|an\s+|the\s+)", "", q, flags=re.I)

    # Fix common typos
    typos = {
        r"\brealstic\b": "realistic",
        r"\bultr\b": "ultra",
        r"\bportriat\b": "portrait",
        r"\bpotrait\b": "portrait",
        r"\bwomn\b": "woman",
        r"\bmna\b": "man",
    }
    for wrong, right in typos.items():
        q = re.sub(wrong, right, q, flags=re.I)

    # Strip punctuation
    q = q.strip().strip(".,!?;:-")

    # Too vague? → add sensible default
    if len(q.split()) <= 1:
        q = f"{q} portrait, beautiful lighting, detailed" if q else "beautiful realistic portrait"

    return q or "beautiful realistic portrait"


def _pick_image_model(prompt):
    l = prompt.lower()
    if any(k in l for k in _TEXT_KEYWORDS):
        return "flux"
    if any(k in l for k in _ART_KEYWORDS):
        return "flux"
    return "flux"  # flux best for realism


def _enhance_prompt(prompt, model):
    p = prompt.strip().rstrip(".,!?")
    lower = p.lower()
    has_quality = sum(
        1 for q in ["8k", "4k", "photorealistic", "masterpiece", "detailed", "hyperrealistic"]
        if q in lower
    )
    if has_quality >= 2:
        return p

    realistic_suffix = (
        ", photorealistic, hyperrealistic, 8k uhd, professional photography, "
        "sharp focus, natural skin texture, cinematic lighting, shot on DSLR, "
        "depth of field, highly detailed, masterpiece, award winning photo"
    )
    art_suffix = ", masterpiece, best quality, ultra detailed, vibrant colors, 8k"

    l = p.lower()
    is_realistic = any(k in l for k in _REALISTIC_KEYWORDS)
    return p + (realistic_suffix if is_realistic else art_suffix)


def _pick_dimensions(prompt):
    l = prompt.lower()
    if any(k in l for k in ["portrait", "vertical", "tall", "phone"]):
        return (768, 1024)
    if any(k in l for k in ["landscape", "wide", "panorama", "horizontal"]):
        return (1024, 768)
    return (1024, 1024)


def detect_image_gen(query):
    q = query.lower().strip()
    for pat in IMAGE_GEN_PATTERNS:
        if re.search(pat, q):
            return _clean_prompt(query)
    return None


def generate_image_pollinations(prompt, model=None):
    clean = _clean_prompt(prompt)
    if not model:
        model = _pick_image_model(clean)

    enhanced = _enhance_prompt(clean, model)
    w, h = _pick_dimensions(clean)

    seed = int(time.time() * 1000) % 100000000
    encoded = urllib.parse.quote(enhanced)

    # referrer + nofeed + nologo → watermark hatao
    url = (
        f"https://image.pollinations.ai/prompt/{encoded}"
        f"?width={w}&height={h}"
        f"&nologo=true"
        f"&nofeed=true"
        f"&referrer=vatsa-ai"
        f"&enhance=true"
        f"&private=true"
        f"&safe=false"
        f"&model={model}"
        f"&seed={seed}"
    )

    logger.info(f"Image gen model={model} size={w}x{h} clean='{clean}'")
    return {
        "image_url": url,
        "prompt": clean,
        "enhanced_prompt": enhanced,
        "model": model,
    }

