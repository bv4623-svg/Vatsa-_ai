# ── Backend API ────────────────────────────
# Public: safe to ship to the browser bundle (it's just the API's own
# public origin, not a secret).
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ── CORS (read by src/proxy.ts, server-side only) ─────────────
# Comma-separated list of origins the proxy will echo back with
# Access-Control-Allow-Credentials -- never a wildcard. Defaults to the
# two local dev origins if unset.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Razorpay (client-side checkout widget) ────
# The secret key belongs on the backend only (Backend/.env) -- checkout
# verification happens there, never in this Next.js app.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
