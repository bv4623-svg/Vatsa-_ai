# ── Backend API ────────────────────────────
# Public: safe to ship to the browser bundle (it's just the API's own
# public origin, not a secret). On Netlify set this to the deployed backend,
# e.g. https://your-api.onrender.com -- it is read at BUILD time, so trigger a
# redeploy after changing it. NEXT_PUBLIC_API_BASE is the legacy name and is
# only a fallback; you do not need to set both.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── CORS (read by src/proxy.ts, server-side only) ─────────────
# Comma-separated list of origins the proxy will echo back with
# Access-Control-Allow-Credentials -- never a wildcard. Defaults to the
# two local dev origins if unset.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Razorpay ─────────────────────────────────
# Nothing to set here. The checkout page fetches the public key id from the
# backend (GET /payment/config), and the key SECRET and webhook secret live
# only in Backend/.env. Never put a RAZORPAY_* value in this file or in the
# Netlify site's environment.
