# ── SMTP / Email ──────────────────────────
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
MAIL_FROM=

# ── AI Provider ────────────────────────────
OPENROUTER_API_KEY=

# ── Web Search (Phase 1.4 / enhanced multi-source search) ──
# DuckDuckGo runs automatically -- no key needed, and gives real,
# current web results on its own. Everything below is optional and
# adds more sources on top of it when configured.
#
# Google Custom Search -- 100 free queries/day.
# Setup: https://programmablesearchengine.google.com/ (new search engine,
# "search the entire web") + enable the Custom Search API in
# https://console.cloud.google.com/ to get an API key.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
# A self-hosted SearxNG instance (public instances block bot/API access,
# so this only works if it's your own). Leave blank to skip.
SEARXNG_URL=
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=

# ── Backend's own public URL ───────────────
# Used to build absolute URLs for server-hosted media (e.g. generated
# images) that get embedded in markdown/<img> tags.
BACKEND_PUBLIC_URL=http://127.0.0.1:8000

# ── Frontend ──────────────────────────────
FRONTEND_REDIRECT_URL=http://localhost:3000

# ── Google OAuth ──────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ── GitHub OAuth ──────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# ── Microsoft OAuth ───────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/auth/microsoft/callback
