        logger.info(f"âœ… {len(parsed_attachments)} attachment(s) ready for LLM")

        result = await router_instance.route(
            query=request.message,
            user_id=request.user_id,
            preferred_model=request.preferred_model,
            user_tier=request.user_tier,
            session={},
            attachments=parsed_attachments,
        )

        if request.conversation_id and request.conversation_id in CONVERSATIONS:
            conv = CONVERSATIONS[request.conversation_id]
            now = datetime.utcnow().isoformat()
            conv["messages"].append({"id": f"msg_{uuid.uuid4().hex[:8]}", "role": "user", "content": request.message, "createdAt": now})
            conv["messages"].append({"id": f"msg_{uuid.uuid4().hex[:8]}", "role": "assistant", "content": result.get("response", ""), "createdAt": now})
            conv["updatedAt"] = now
