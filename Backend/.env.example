# ── SMTP / Email ──────────────────────────
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
MAIL_FROM=

# ── AI Provider ────────────────────────────
OPENROUTER_API_KEY=

# ── Web Search (Phase 1.4 / enhanced multi-source search) ──
# At least one is needed for real search results; without any, chat
# degrades gracefully (no search, no crash). Wikipedia needs no key.
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=

# ── Backend's own public URL ───────────────
# Used to build absolute URLs for server-hosted media (e.g. generated
# images) that get embedded in markdown/<img> tags.
BACKEND_PUBLIC_URL=http://127.0.0.1:8000

# ── Frontend ──────────────────────────────
FRONTEND_REDIRECT_URL=http://localhost:3000

# ── Google OAuth ──────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ── GitHub OAuth ──────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# ── Microsoft OAuth ───────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/auth/microsoft/callback
