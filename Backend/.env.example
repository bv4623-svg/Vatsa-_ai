# ── CORS ───────────────────────────────────
# Comma-separated list of origins allowed to call this API with credentials.
# Defaults to the two local dev origins if unset.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── JWT signing secret ────────────────────
# Required -- the app refuses to start without it. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Use a DIFFERENT value per environment (dev/staging/prod) and rotate it if
# it is ever exposed; rotating invalidates every session immediately.
JWT_SECRET_KEY=

# ── SMTP / Email ──────────────────────────
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
MAIL_FROM=

# ── AI Provider ────────────────────────────
OPENROUTER_API_KEY=
# Model used for reasoning/"show thinking" mode -- must be one that
# emits a separate reasoning field (deepseek-r1, o1-mini, etc).
REASONING_MODEL=deepseek/deepseek-r1
# Vision-capable model for /api/vision/analyze and image attachments.
VISION_MODEL=openai/gpt-4o

# ── Web Search (multi-source, all providers run in parallel) ──
# DuckDuckGo runs automatically -- no key needed -- and alone already
# gives real, current, correctly-ranked results (verified live). Every
# provider below is optional and adds more sources on top of it.
#
# Self-hosted SearxNG (recommended primary -- unlimited, aggregates
# Google+Bing+DDG). Public instances block bot/API access (verified:
# every one tried returned a bot-check page or 429), so this only does
# anything useful pointed at your own instance:
#   docker run -d -p 8080:8080 searxng/searxng
SEARXNG_URL=
SEARXNG_API_KEY=

# Optional paid providers (higher quality, add on top of DDG/SearxNG)
SERPER_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=

# Legacy -- Google is retiring Custom Search JSON API in 2027. Kept as
# an optional extra source in the meantime; not required for anything.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# ── Backend's own public URL ───────────────
# Used to build absolute URLs for server-hosted media (e.g. generated
# images) that get embedded in markdown/<img> tags.
BACKEND_PUBLIC_URL=http://127.0.0.1:8000

# ── Frontend ──────────────────────────────
FRONTEND_REDIRECT_URL=http://localhost:3000

# ── Google OAuth ──────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ── GitHub OAuth ──────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# ── Microsoft OAuth ───────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/auth/microsoft/callback

# ── Razorpay (Pro / Business payments) ────
# Razorpay is the only payment gateway. Without KEY_ID and KEY_SECRET the
# API reports payments as unconfigured (GET /payment/config) and checkout is
# disabled -- it never fakes an order and never grants a plan without a
# valid signature.
#
# TEST MODE first: Dashboard > toggle "Test Mode" > Account & Settings > API
# Keys > Generate Test Key. Test key ids start with rzp_test_. Going live
# means swapping in rzp_live_ keys -- see DEPLOYMENT.md.
#
# USD charges need "International Payments" enabled on the Razorpay
# account; INR charges work without it.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks > Add: URL {BACKEND_PUBLIC_URL}/payment/webhook,
# events "payment.captured" and "refund.processed", and a secret of your
# choosing pasted here. payment.captured upgrades the account even if the
# customer closes the tab right after paying; refund.processed ends the
# access a fully refunded payment bought.
RAZORPAY_WEBHOOK_SECRET=
