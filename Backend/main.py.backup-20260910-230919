class SmartCache:
    def __init__(self, ttl=3600): self.cache = {}; self.ttl = ttl
    def get(self, key):
        if key in self.cache:
            data, ts = self.cache[key]
            if time.time() - ts < self.ttl: return data
            del self.cache[key]
        return None
    def set(self, key, value): self.cache[key] = (value, time.time())


