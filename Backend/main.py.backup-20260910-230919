    text = (text or "").strip()[:20000]
    if not text: raise HTTPException(400, "Could not extract any text from file")
    FILE_STORE[file_id] = {"filename": filename, "text": text, "user_id": current_user.email, "uploaded_at": time.time(), "size_bytes": len(raw)}
    logger.info(f"ðŸ“Ž Uploaded {filename} â†’ {file_id} ({len(text)} chars)")
    return {"file_id": file_id, "filename": filename, "chars": len(text), "size_bytes": len(raw)}


def _extract_text_from_bytes(raw: bytes, filename: str) -> str:
    lower = filename.lower()
    if lower.endswith(".pdf"):
        if not PDF_SUPPORT:
            raise HTTPException(500, "PDF support not installed. Run: pip install pdfplumber")
        text = ""
        try:
            with pdfplumber.open(io.BytesIO(raw)) as pdf:
                text = "\n".join((p.extract_text() or "") for p in pdf.pages)
            logger.info(f"pdfplumber extracted {len(text)} chars from {filename}")
        except Exception as e:
            logger.error(f"pdfplumber failed on {filename}: {e}")

        if not text.strip() and OCR_SUPPORT:
            logger.info(f"pdfplumber returned empty â†’ trying OCR on {filename}")
            try:
                images = convert_from_bytes(raw, poppler_path=POPPLER_PATH)
                ocr_parts = [pytesseract.image_to_string(img) for img in images]
                text = "\n".join(ocr_parts)
                logger.info(f"OCR extracted {len(text)} chars from {filename}")
            except Exception as e:
                logger.error(f"OCR failed on {filename}: {e}")

        return text

    elif lower.endswith((".txt", ".md", ".csv", ".json", ".log", ".py", ".js", ".ts", ".html", ".css")):
        return raw.decode("utf-8", errors="ignore")
    else:
        raise HTTPException(400, f"Unsupported file type: {filename}")


def _parse_attachment(att: Union[str, Dict[str, Any]]) -> Optional[Dict[str, Any]]:
    if isinstance(att, str):
        info = FILE_STORE.get(att)
        if not info:
            logger.warning(f"Attachment file_id {att} not found")
            return None
        return {"filename": info.get("filename", "file"), "text": info.get("text", "")}

    if isinstance(att, dict):
        filename = att.get("name") or att.get("filename") or "file"
        content = att.get("content") or ""

        logger.info(f"ðŸ” Attachment: name={filename} type={att.get('type')} is_base64={att.get('is_base64')} content_len={len(content)}")

        if att.get("text"):
            return {"filename": filename, "text": att["text"]}

        if not content:
            logger.warning(f"Attachment {filename} has empty content")
            return None

        b64_data = content
        if content.strip().startswith("data:") and "," in content:
            b64_data = content.split(",", 1)[1]

        pad = len(b64_data) % 4
        if pad: b64_data += "=" * (4 - pad)

        try:
            raw = _b64.b64decode(b64_data)
            logger.info(f"ðŸ” Decoded {len(raw)} bytes from {filename}")
        except Exception as e:
            logger.error(f"Base64 decode failed for {filename}: {e}")
            return None

        try:
            text = _extract_text_from_bytes(raw, filename)
        except HTTPException as e:
            logger.error(f"Extraction failed for {filename}: {e.detail}")
            return None
        except Exception as e:
            logger.error(f"Extraction failed for {filename}: {e}")
            return None

        text = (text or "").strip()[:20000]
        if not text:
            logger.warning(f"âš ï¸ No text extracted from {filename} (raw={len(raw)} bytes).")
            return None

        logger.info(f"ðŸ“Ž Parsed inline attachment {filename} ({len(text)} chars)")
        return {"filename": filename, "text": text}

    logger.warning(f"Unknown attachment format: {type(att)}")
    return None


