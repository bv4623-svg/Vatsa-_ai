# Read by `next build` / `next start` (production only). Public values only:
# anything NEXT_PUBLIC_* is visible in the browser. Never put a secret here.
#
# The deployed backend. Netlify can override it with an environment variable of
# the same name (Site configuration > Environment variables).
NEXT_PUBLIC_API_URL=https://vatsa-ai.onrender.com

# Public origin of this site. Used for canonical and share-image (Open Graph) URLs;
# without it they would point at the wrong address.
NEXT_PUBLIC_SITE_URL=https://vatsaai.netlify.app
