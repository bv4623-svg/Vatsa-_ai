# Vatsa AI backend configuration. Copy to .env and fill in real values --
# never commit .env itself (it's already in .gitignore). Every variable
# below is actually read by the code; nothing here is speculative.
#
# ════════════════════════════════════════════════════════════════════
# REQUIRED IN PRODUCTION
# ════════════════════════════════════════════════════════════════════

# ── Database ───────────────────────────────
# Without this, the app falls back to a local SQLite file (fine for local
# development, NOT safe for a real multi-instance production deployment --
# see app/database.py). Set to a real PostgreSQL URL in production:
#   postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ── JWT signing secret ────────────────────
# Required -- the app refuses to start without it. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Use a DIFFERENT value per environment (dev/staging/prod) and rotate it if
# it is ever exposed; rotating invalidates every session immediately.
JWT_SECRET_KEY=

# ── CORS ───────────────────────────────────
# Comma-separated list of origins allowed to call this API with credentials.
# Exact origins only (scheme + host + port), never a wildcard. If unset, the
# live frontend and this API are allowed (the value below). For local
# development, put your own local frontend origin in your private .env.
ALLOWED_ORIGINS=https://vatsaai.netlify.app,https://vatsa-ai.onrender.com

# ── Frontend / backend URLs ────────────────
# Where OAuth logins send the browser afterwards. No trailing slash.
FRONTEND_REDIRECT_URL=https://vatsaai.netlify.app
# Used to build absolute URLs for server-hosted media (e.g. generated
# images) that get embedded in markdown/<img> tags.
BACKEND_PUBLIC_URL=https://vatsa-ai.onrender.com

# ── SMTP / Email (OTP delivery) ────────────
# Without valid credentials, OTP send/resend returns 503 -- signup, login-by-
# OTP and password reset all depend on this actually working.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
MAIL_FROM=

# ── Google OAuth ("Continue with Google") ──
# All three required together -- unset/blank and the button shows a
# "not configured" error instead of trying and failing. GOOGLE_REDIRECT_URI
# must be this backend's own https URL + /api/auth/google/callback, and must
# be registered EXACTLY as an Authorized redirect URI in the Google Cloud
# Console OAuth client (Credentials > OAuth 2.0 Client IDs). Not localhost
# in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://vatsa-ai.onrender.com/api/auth/google/callback

# ── Razorpay (Pro / Business payments) ────
# Razorpay is the only payment gateway. Without KEY_ID and KEY_SECRET the
# API reports payments as unconfigured (GET /payment/config) and checkout is
# disabled -- it never fakes an order and never grants a plan without a
# valid signature.
#
# TEST MODE first: Dashboard > toggle "Test Mode" > Account & Settings > API
# Keys > Generate Test Key. Test key ids start with rzp_test_. Going live
# means swapping in rzp_live_ keys -- see DEPLOYMENT.md.
#
# USD charges need "International Payments" enabled on the Razorpay
# account; INR charges work without it.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks > Add: URL {BACKEND_PUBLIC_URL}/payment/webhook,
# events "payment.captured" and "refund.processed", and a secret of your
# choosing pasted here. payment.captured upgrades the account even if the
# customer closes the tab right after paying; refund.processed ends the
# access a fully refunded payment bought.
RAZORPAY_WEBHOOK_SECRET=
#
# Razorpay KYC also requires src/config/business.json (frontend repo) to
# have a real legalName, addressLines and phone -- see that file and
# `npm run check:business`. That is business/legal information only the
# account owner can provide; this backend does not invent it.

# ── AI Provider ────────────────────────────
# Without this, every AI request fails (the router has no working adapter).
OPENROUTER_API_KEY=

# ── Admin access ───────────────────────────
# Comma-separated emails allowed to use /api/admin/* (payment lookup, the
# AI Router status/metrics endpoints). Empty means nobody. An admin must
# ALSO have a verified email, two-factor authentication enabled, and sign in
# with a normal session (API keys and old non-revocable tokens are refused).
ADMIN_EMAILS=


# ════════════════════════════════════════════════════════════════════
# OPTIONAL -- each has a working default or a safe automatic fallback
# ════════════════════════════════════════════════════════════════════

# ── Redis ──────────────────────────────────
# When set (and reachable), auth/OTP/admin rate limiting
# (app/utils/rate_limit.py) is shared across every API instance via Redis
# instead of each instance's own process memory -- needed once you run more
# than one instance behind a load balancer. Unset, unreachable, or the
# `redis` package missing: falls back to in-process limiting automatically
# (logged, not fatal) -- the app still starts and still works on one instance.
# redis://default:password@host:6379/0
REDIS_URL=

# ── PostgreSQL connection pool ─────────────
# Only used when DATABASE_URL above is a non-SQLite (e.g. Postgres) URL. If
# left unset, the code's own default is a conservative 5/10/1800 for a
# single small instance -- see app/database.py. The values below are a
# starting point for a real horizontally-scaled deployment; raise
# DB_POOL_SIZE roughly in step with how many API instances/workers you run,
# and check it against your Postgres server's own max_connections.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_RECYCLE_SECONDS=1800

# ── Request handling ───────────────────────
# A backstop, not the primary defense -- see app/middleware/timeout.py.
# Streaming chat responses are exempt (bounded by AI_TOTAL_TIMEOUT_MS instead).
REQUEST_TIMEOUT_SECONDS=30

# ── Session tokens ─────────────────────────
JWT_ALGORITHM=HS256
# Minutes. Default is 7 days.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Local development only. When true, a generated OTP code is also printed to
# the console (see app/routers/auth/otp.py) -- useful when SMTP isn't set up
# yet. Leave unset/false everywhere else: an OTP code must never appear in
# logs.
DEBUG_LOG_OTP=false

# ── AI Router (app/ai_router) ─────────────
# Every one of these has a working default. See app/ai_router/config.py for
# the full docstring and app/ai_router/engine.py for how they're used.
# Provider/model identity is never exposed to end users (see
# app/ai_router/sanitize.py) regardless of these settings.
#
# Model used for reasoning/"show thinking" mode -- must be one that emits a
# separate reasoning field (deepseek-r1, o1-mini, etc). Ignored when
# AI_ROUTER_CONFIG_PATH points at a JSON registry instead.
REASONING_MODEL=deepseek/deepseek-r1
# Vision-capable model for /api/vision/analyze and image attachments.
VISION_MODEL=openai/gpt-4o
# Public route name used when a client sends an unknown/missing model name.
# Unknown names can NEVER select a specific provider model directly -- they
# always resolve to this route instead.
AI_DEFAULT_ROUTE=auto
# false = a failed model returns an error instead of trying the next one.
AI_FALLBACK_ENABLED=true
# Extra attempts per model (in addition to the first) before falling back.
AI_MAX_RETRIES=1
# Per-attempt timeout, milliseconds.
AI_TIMEOUT_MS=30000
# Deadline for one whole request -- every retry and fallback included --
# measured from when it entered the router, milliseconds.
AI_TOTAL_TIMEOUT_MS=90000
# priority | cost | latency | load | hybrid. "priority" reproduces the
# fixed fallback order this backend used before the router existed.
AI_ROUTER_STRATEGY=priority
# Only used when AI_ROUTER_STRATEGY=hybrid, e.g. "cost=0.4,latency=0.3,load=0.1,availability=0.1,priority=0.1"
AI_ROUTER_WEIGHTS=
# Consecutive failures before a model's circuit breaker opens.
AI_BREAKER_FAILURES=5
# Seconds a breaker stays open before allowing one probe call.
AI_BREAKER_COOLDOWN_S=30
AI_BREAKER_HALF_OPEN_CALLS=1
# Run each provider adapter's health_check() from the admin status endpoint.
AI_PROVIDER_HEALTH_CHECK=true
# Concurrent AI calls this process will run before shedding new requests
# with a 503 (backpressure -- see app/ai_router/admission.py). Tune this
# down on a small instance; horizontal scaling adds more instances rather
# than raising this number indefinitely.
AI_MAX_INFLIGHT=256
# Path to a JSON file (see ai_router.example.json) that replaces the
# built-in model/route registry entirely. Leave unset to use the built-in
# registry, which reproduces this backend's routing from before the router
# existed (same models, same fallback order, same premium-tier rule).
AI_ROUTER_CONFIG_PATH=

# ── GitHub OAuth ("Continue with GitHub") ──
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://vatsa-ai.onrender.com/api/auth/github/callback

# ── Microsoft OAuth ("Continue with Microsoft") ──
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=https://vatsa-ai.onrender.com/api/auth/microsoft/callback

# ── Linking an already-signed-in account to Google/GitHub ──
# (Settings > Connections -- different from the login flows above.) Falls
# back to GOOGLE_REDIRECT_URI / GITHUB_REDIRECT_URI if left unset; only set
# these if the linking callback needs a different URL than login's.
GOOGLE_LINK_REDIRECT_URI=
GITHUB_LINK_REDIRECT_URI=

# ── Web Search (multi-source, all providers run in parallel) ──
# DuckDuckGo runs automatically -- no key needed -- and alone already
# gives real, current, correctly-ranked results (verified live). Every
# provider below is optional and adds more sources on top of it.
#
# Self-hosted SearxNG (recommended primary -- unlimited, aggregates
# Google+Bing+DDG). Public instances block bot/API access (verified:
# every one tried returned a bot-check page or 429), so this only does
# anything useful pointed at your own instance:
#   docker run -d -p 8080:8080 searxng/searxng
SEARXNG_URL=
SEARXNG_API_KEY=

# Optional paid providers (higher quality, add on top of DDG/SearxNG)
SERPER_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=

# Legacy -- Google is retiring Custom Search JSON API in 2027. Kept as
# an optional extra source in the meantime; not required for anything.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# ── Where data is stored ───────────────────
# Directory for uploads, generated images, and the SQLite database (only
# when DATABASE_URL above is unset). Leave empty for local development (the
# Backend folder). On a host, point it at a persistent disk, e.g. /data --
# anything outside a persistent disk is erased on every deploy or restart.
DATA_DIR=
